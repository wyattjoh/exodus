{
  "name": "exodus-time-dialation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "bun run scripts/minimal-scenario.ts",
    "worker-demo": "bun run scripts/worker-planning-demo.ts",
    "benchmark:cluster-route": "bun run scripts/cluster-route-benchmark.ts",
    "benchmark:webgpu-scale": "bun run scripts/webgpu-scale-benchmark.ts",
    "benchmark:webgpu-scale:reference": "bun run scripts/webgpu-scale-reference.ts",
    "benchmark:webgpu-scale:conformance": "bun run scripts/webgpu-scale-conformance.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "browser:dev": "bun run dev",
    "browser:build": "bun run build",
    "browser:preview": "bun run preview",
    "pwa:offline-smoke": "bun run build && bun run scripts/pwa-offline-smoke.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}

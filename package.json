{
  "name": "exodus-time-dialation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "demo": "bun run scripts/minimal-scenario.ts",
    "worker-demo": "bun run scripts/worker-planning-demo.ts",
    "benchmark:cluster-route": "bun run scripts/cluster-route-benchmark.ts",
    "benchmark:webgpu-scale": "bun run scripts/webgpu-scale-benchmark.ts",
    "benchmark:webgpu-scale:reference": "bun run scripts/webgpu-scale-reference.ts",
    "benchmark:webgpu-scale:conformance": "bun run scripts/webgpu-scale-conformance.ts",
    "dev": "npm_execpath= npm_config_user_agent= alchemy dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "plan": "npm_execpath= npm_config_user_agent= alchemy plan --stage prod",
    "deploy": "npm_execpath= npm_config_user_agent= alchemy deploy --stage prod",
    "deploy:ci": "npm_execpath= npm_config_user_agent= alchemy deploy --stage prod --yes",
    "destroy": "npm_execpath= npm_config_user_agent= alchemy destroy --stage prod",
    "bootstrap:cloudflare": "npm_execpath= npm_config_user_agent= alchemy cloudflare bootstrap",
    "bootstrap:ci": "npm_execpath= npm_config_user_agent= alchemy deploy alchemy.ci.ts --stage prod --profile admin --yes",
    "browser:dev": "vite --host 127.0.0.1",
    "browser:build": "bun run build",
    "browser:preview": "bun run preview",
    "pwa:offline-smoke": "bun run build && bun run scripts/pwa-offline-smoke.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:visual": "PLAYWRIGHT_LAST_RUN_OUTPUT_FILE=.scratch/playwright/last-run.json playwright test",
    "test:visual:screenshots": "PLAYWRIGHT_LAST_RUN_OUTPUT_FILE=.scratch/playwright/last-run.json STAR_MAP_SCREENSHOTS=1 playwright test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "alchemy": "2.0.0-beta.77",
    "typescript": "^5.7.2",
    "vite": "8.0.16"
  },
  "resolutions": {
    "effect": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112"
  }
}
